    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\n\n// Telegram message extract\nconst message = String(\n  data.message?.text ??\n  data.text ??\n  \"\"\n).trim();\n\n// Chat ID extract\nconst chat_id =\n  data.message?.chat?.id ??\n  data.chat?.id ??\n  data.chat_id;\n\n// Validate message\nif (!message) {\n  throw new Error(\"Telegram message nahi mila.\");\n}\n\nif (chat_id === undefined || chat_id === null) {\n  throw new Error(\"Chat ID nahi mili.\");\n}\n\n// Regex to extract APPROVE/REJECT and Content ID (e.g. 363-7)\nconst match = message.match(/(APPROVE|REJECT)\\s+(\\d+-\\d+)/i);\n\nif (!match) {\n  throw new Error(\n    \"Invalid command. Telegram par APPROVE 46-1 ya REJECT 46-1 bhejo.\"\n  );\n}\n\nconst action = match[1].toUpperCase();\nconst contentId = match[2];\n\nconst approvalStatus =\n  action === \"APPROVE\" ? \"Approved\" : \"Rejected\";\n\n// Agar Approve ho toh Kolkata timestamp, agar Reject ho toh Blank String \"\"\nconst approvedAt =\n  action === \"APPROVE\"\n    ? new Date().toLocaleString(\"sv-SE\", {\n        timeZone: \"Asia/Kolkata\"\n      }).replace(\" \", \"T\")\n    : \"\";\n\n// Agar Reject ho toh Scheduled Date ko bhi blank string \"\" kar do\nconst scheduledDate = action === \"REJECT\" ? \"\" : undefined;\n\n// Output matching your exact Google Sheets columns and workflow needs\nreturn [\n  {\n    json: {\n      action: action,\n      content_id: contentId,            // Telegram nodes ke liye\n      Content_ID: contentId,            // Google Sheet column match\n      Approval_Status: approvalStatus,  // Google Sheet column match\n      chat_id: chat_id,\n      Approved_At: approvedAt,          // Google Sheet column match (Rejection par blank)\n      Scheduled_Date: scheduledDate      // Google Sheet column match (Rejection par blank)\n    }\n  }\n];"
      },
