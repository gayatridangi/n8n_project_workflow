        "text": "={{\n  (() => {\n    const d = $json;\n\n    // Day Extract karne ke liye (Content_ID = \"529-1\", \"529-2\" etc.)\n    const dayNumber = String(d.Content_ID || '').split('-')[1] || '';\n    const dayHeader = dayNumber ? `📅 DAY ${dayNumber}\\n\\n` : '';\n\n    const linkedin =\n      d.LinkedIn_Post ?? d.linkedin_post ??\n      d['LinkedIn Post'] ?? d.linkedinPost;\n\n    const xthread =\n      d.X_Thread ?? d.x_thread ??\n      d['X Thread'] ?? d.xThread;\n\n    const instagram =\n      d.Instagram_Caption ?? d.instagram_caption ??\n      d['Instagram Caption'] ?? d.instagramCaption;\n\n    return (\n      dayHeader +\n      'LinkedIn Post:\\n\\n' + (linkedin ?? 'Content field not found') +\n      '\\n\\n--------------------\\n\\n' +\n      'X Thread:\\n\\n' + (xthread ?? 'Content field not found') +\n      '\\n\\n--------------------\\n\\n' +\n      'Instagram Caption:\\n\\n' + (instagram ?? 'Content field not found')\n    );\n  })()\n}}",
        "additionalFields": {}
